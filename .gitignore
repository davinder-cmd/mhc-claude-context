# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude internals (session cache, local settings) — but track hand-authored skills
.claude/*
!.claude/skills

# Skills and plugins (managed separately)
.skills/
.remote-plugins/
.gstack/

# Source photography library (660MB of licensed stock — kept local, not in history).
# Audit outputs derived from it (CSVs, galleries, reports) ARE tracked under outputs/.
projects/imagery/

# Impeccable local tool state (per-machine, not shared)
.impeccable/config.local.json
